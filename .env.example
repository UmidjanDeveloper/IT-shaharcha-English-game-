# Server-only keys: put them in .env.local (local) or Vercel → Project → Settings → Environment Variables.
# Never put real keys in this file or in the browser code.

# OpenAI: AI ustoz chati, Speaking/Writing band baholash, examiner savollari, grammatika mashqlari, yangi savollar
OPENAI_API_KEY=
# Optional. If unset or unavailable for your key, the server tries gpt-5.4-mini → gpt-5-mini → gpt-4o-mini.
OPENAI_MODEL=
# Optional. Speech-to-text (English and Uzbek). Default gpt-4o-mini-transcribe, fallback whisper-1.
OPENAI_TRANSCRIBE_MODEL=

# ElevenLabs: examiner va ustoz ovozi
ELEVENLABS_API_KEY=
# English examiner voice. Default: JBFqnCBsd6RMkjVDRZzb (George, British premade voice)
ELEVENLABS_VOICE_ID_EN=
# Uzbek teacher voice. Default: Xb7hH8MSUJpSbSDYk0k2 (Alice premade voice, spoken through eleven_v3)
ELEVENLABS_VOICE_ID_UZ=
# Models. Defaults: English eleven_multilingual_v2, Uzbek eleven_v3
ELEVENLABS_MODEL_EN=
ELEVENLABS_MODEL_UZ=

# Optional protection against strangers using your API credit: if set, the teacher types this code once per browser.
CLUB_ACCESS_CODE=
# Requests per minute per IP (a whole classroom shares one IP). Default 90.
TUTOR_RATE_LIMIT=
